# Sao chép thành .env rồi điền. Không commit .env.

# Postgres. Máy dev: đặt mật khẩu bất kỳ (chữ và số). VPS: mật khẩu mạnh.
POSTGRES_PASSWORD=
# Cổng trên máy dev. Đổi nếu 5432 đã có chương trình khác dùng.
DB_PORT=5432

# Google, chỉ đọc (GĐ 0.4)
GOOGLE_SA_KEY=secrets/google-sa.json
SHEET_ID=
SHEET_TAB=Van_ban
FOLDER_ID=

# LLM + embedding qua OpenRouter (GĐ 1.4). Key: openrouter.ai → Keys.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=baai/bge-m3
LLM_MODEL=google/gemini-3.1-flash-lite
